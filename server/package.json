{
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc && copyfiles -u 1 \"src/generated/**/*\" dist/",
    "dev": "nodemon src/server.ts",
    "prepare": "husky install",
    "seed": "ts-node prisma/seed.ts",
    "reset-db": "ts-node src/utils/clear/cleardata.ts",
    "build:schema": "./scripts/build-schema.sh",
    "prisma:generate": "npm run build:schema && npx prisma generate",
    "prisma:migrate:dev": "npm run build:schema && npx prisma migrate dev",
    "prisma:migrate:deploy": "npm run build:schema && npx prisma migrate deploy",
    "prisma:push": "npm run build:schema && npx prisma db push",
    "prisma:studio": "npm run build:schema && npx prisma studio",
    "prisma:validate": "npm run build:schema && npx prisma validate"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@supabase/supabase-js": "^2.49.4",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.2.1",
    "node-wkhtmltopdf": "^2.0.0",
    "nodemailer": "^7.0.3",
    "nodemon": "^3.1.9",
    "pdfkit": "^0.17.2",
    "pdfkit-table": "^0.1.99",
    "playwright": "^1.56.1",
    "puppeteer": "^24.29.1",
    "sib-api-v3-sdk": "^8.5.0",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/date-fns": "^2.6.3",
    "@types/express": "^5.0.1",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.19.7",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "@types/xlsx": "^0.0.36",
    "copyfiles": "^2.4.1",
    "eslint": "^9.24.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "prisma": "^6.6.0",
    "prisma-erd-generator": "^2.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
